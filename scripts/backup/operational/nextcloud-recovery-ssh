#!/bin/sh
set -eu
case "${SSH_ORIGINAL_COMMAND:-}" in
  'sudo -n /usr/local/libexec/nextcloud-recovery lease') exec sudo -n /usr/local/libexec/nextcloud-recovery lease ;;
  'sudo -n /usr/local/libexec/nextcloud-recovery backup') exec sudo -n /usr/local/libexec/nextcloud-recovery backup ;;
  *) exit 2 ;;
esac
