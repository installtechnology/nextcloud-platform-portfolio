variables {
  aws_account_id      = "000000000000"
  aws_region          = "us-east-1"
  project_name        = "fixture"
  environment         = "test"
  data_bucket_name    = "fixture-source-data"
  backups_bucket_name = "fixture-backups"
  state_bucket_name   = "fixture-state"
  github_oidc         = { owner = "fixture", repository = "platform", environment = "test", owner_id = "123", repository_id = "456", existing_provider_arn = "arn:aws:iam::000000000000:oidc-provider/token.actions.githubusercontent.com" }
}
run "disabled_creation" {
  command = plan
  assert {
    condition     = length(aws_iam_role.reprovision) == 0 && length(aws_iam_policy.reprovision_boundary) == 0 && length(aws_iam_role_policy.reprovision_issuer) == 0
    error_message = "Publication must not activate cold creation."
  }
}
run "scoped_creation" {
  # Mock apply resolves IAM data sources that depend on a newly mocked boundary.
  # This file never uses a real provider or an operational backend.
  command = apply
  variables {
    github_restore     = { destination_environment = "restore", destination_bucket_name = "fixture-destination" }
    github_reprovision = { destination_environment = "restore", destination_data_bucket = "fixture-destination", grant_issuer_arn = "arn:aws:iam::000000000000:role/fixture-issuer" }
  }
  assert {
    condition     = length(aws_iam_role.reprovision) == 1 && aws_iam_role.reprovision[0].permissions_boundary == aws_iam_policy.reprovision_boundary[0].arn && length(local.creation_boundary) <= 6144 && length(local.creation_policy) <= 10240
    error_message = "Dedicated boundary and real rendered IAM size limits required."
  }
  assert {
    condition     = length(aws_iam_role.restore) == 1 && local.restore_target_arn == "arn:aws:ec2:us-east-1:000000000000:instance/*"
    error_message = "Only opted-in destination tag-scoped discovery is enabled."
  }
  assert {
    condition     = jsondecode(aws_iam_role.reprovision[0].assume_role_policy).Statement[0].Condition.StringEquals["token.actions.githubusercontent.com:workflow"] == "Deploy platform (manual)"
    error_message = "Only the existing manually authorized deploy may create a destination."
  }
}
run "reject_operational_issuer" {
  command = plan
  variables {
    github_restore     = { destination_environment = "restore", destination_bucket_name = "fixture-destination" }
    github_reprovision = { destination_environment = "restore", destination_data_bucket = "fixture-destination", grant_issuer_arn = "arn:aws:iam::000000000000:role/fixture-test-reprovision" }
  }
  expect_failures = [var.github_reprovision]
}
run "reject_incompatible_destination" {
  command = plan
  variables {
    github_restore     = { destination_environment = "restore", destination_bucket_name = "fixture-destination" }
    github_reprovision = { destination_environment = "other", destination_data_bucket = "fixture-destination", grant_issuer_arn = "arn:aws:iam::000000000000:role/fixture-issuer" }
  }
  expect_failures = [var.github_reprovision]
}
