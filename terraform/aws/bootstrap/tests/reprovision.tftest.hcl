ceProfileAssociation\",\n        \"ec2:ModifyVpcAttribute\",\n        \"ec2:ModifyVolume\",\n        \"ec2:ModifySubnetAttribute\",\n        \"ec2:ModifySecurityGroupRules\",\n        \"ec2:ModifyInstanceMetadataOptions\",\n        \"ec2:ModifyInstanceCreditSpecification\",\n        \"ec2:ModifyInstanceAttribute\",\n        \"ec2:GetConsoleOutput\",\n        \"ec2:DisassociateRouteTable\",\n        \"ec2:DisassociateIamInstanceProfile\",\n        \"ec2:DetachInternetGateway\",\n        \"ec2:DeleteVpc\",\n        \"ec2:DeleteTags\",\n        \"ec2:DeleteSubnet\",\n        \"ec2:DeleteSecurityGroup\",\n        \"ec2:DeleteRouteTable\",\n        \"ec2:DeleteRoute\",\n        \"ec2:DeleteKeyPair\",\n        \"ec2:DeleteInternetGateway\",\n        \"ec2:CreateTags\",\n        \"ec2:CreateRoute\",\n        \"ec2:AuthorizeSecurityGroupIngress\",\n        \"ec2:AuthorizeSecurityGroupEgress\",\n        \"ec2:AttachInternetGateway\",\n        \"ec2:AssociateRouteTable\",\n        \"ec2:AssociateIamInstanceProfile\"\n      ],\n      \"Resource\": [\n        \"arn:aws:ec2:us-east-1:000000000000:vpc/*\",\n        \"arn:aws:ec2:us-east-1:000000000000:volume/*\",\n        \"arn:aws:ec2:us-east-1:000000000000:subnet/*\",\n        \"arn:aws:ec2:us-east-1:000000000000:security-group/*\",\n        \"arn:aws:ec2:us-east-1:000000000000:security-group-rule/*\",\n        \"arn:aws:ec2:us-east-1:000000000000:route-table/*\",\n        \"arn:aws:ec2:us-east-1:000000000000:key-pair/*\",\n        \"arn:aws:ec2:us-east-1:000000000000:internet-gateway/*\",\n        \"arn:aws:ec2:us-east-1:000000000000:instance/*\"\n      ],\n      \"Condition\": {\n        \"StringEquals\": {\n          \"aws:ResourceTag/Environment\": \"test\",\n          \"aws:ResourceTag/Project\": \"fixture\"\n        }\n      }\n    },\n    {\n      \"Sid\": \"CanonicalAMIOnly\",\n      \"Effect\": \"Allow\",\n      \"Action\": \"ssm:GetParameter\",\n      \"Resource\": \"arn:aws:ssm:us-east-1::parameter/aws/service/canoni