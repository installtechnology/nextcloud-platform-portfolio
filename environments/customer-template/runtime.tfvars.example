aws_account_id = "REPLACE_WITH_ACCOUNT_ID"
aws_region             = "REPLACE_WITH_CUSTOMER_REGION"
project_name           = "replace-project"
environment            = "replace-env"
data_bucket_name = "replace-with-customer-unique-data-bucket-name"
ssh_public_key         = "REPLACE_WITH_CUSTOMER_OPENSSH_PUBLIC_KEY"
ssh_allowed_cidrs      = ["REPLACE_WITH_CUSTOMER_ADMIN_IPV4/32"]
http_allowed_cidrs     = ["REPLACE_WITH_CUSTOMER_DEMO_IPV4/32"]
# instance_type pode ser definido pelo operador; omitido para herdar o default do root.
# root_volume_size_gib omitido: herda o default; ajuste somente após medição.
# ec2_permissions_boundary_arn = "REPLACE_WITH_BOOTSTRAP_OUTPUT"
