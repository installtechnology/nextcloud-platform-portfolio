{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nextcloud-platform:recovery:object-inventory:1",
  "title": "Nextcloud recovery object-inventory v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "backup_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "consistency_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9-]{1,63}(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]{12}(?![\\s\\S])"
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,63}(?![\\s\\S])"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,63}(?![\\s\\S])"
        },
        "installation_identity_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "data_bucket": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9](?![\\s\\S])"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+(?![\\s\\S])"
        }
      },
      "required": [
        "account_id",
        "project",
        "environment",
        "installation_identity_sha256",
        "data_bucket",
        "region"
      ]
    },
    "selection": {
      "const": "visible_current_objects_at_quiesced_capture"
    },
    "listing_complete": {
      "const": true
    },
    "object_count": {
      "type": "integer",
      "minimum": 0
    },
    "objects": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "version_id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!null(?![\\s\\S]))[^\\s\\x00-\\x1f\\x7f]+(?![\\s\\S])",
            "maxLength": 1024
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "etag": {
            "type": "string",
            "minLength": 1
          },
          "checksum": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "algorithm": {
                    "enum": [
                      "SHA256",
                      "SHA1",
                      "CRC32",
                      "CRC32C",
                      "CRC64NVME"
                    ]
                  },
                  "value_base64": {
                    "type": "string",
                    "minLength": 1,
                    "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?(?![\\s\\S])"
                  },
                  "type": {
                    "enum": [
                      "FULL_OBJECT",
                      "COMPOSITE"
                    ]
                  },
                  "part_count": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 10000
                  }
                },
                "required": [
                  "algorithm",
                  "value_base64",
                  "type"
                ],
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "type": {
                          "const": "COMPOSITE"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "part_count"
                      ]
                    },
                    "else": {
                      "not": {
                        "required": [
                          "part_count"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "algorithm": {
                          "const": "CRC64NVME"
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "type": {
                          "const": "FULL_OBJECT"
                        }
                      }
                    }
                  }
                ]
              }
            ]
          }
        },
        "required": [
          "key",
          "version_id",
          "size_bytes",
          "etag",
          "checksum"
        ]
      }
    },
    "absent_current_keys": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "schema_version",
    "backup_id",
    "consistency_id",
    "source",
    "selection",
    "listing_complete",
    "object_count",
    "objects",
    "absent_current_keys"
  ]
}
