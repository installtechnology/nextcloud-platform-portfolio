{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nextcloud-platform:recovery:restore-evidence:2",
  "title": "Nextcloud recovery restore-evidence v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "backup_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "manifest_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "account_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9]{12}(?![\\s\\S])"
        },
        "project": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,63}(?![\\s\\S])"
        },
        "environment": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,63}(?![\\s\\S])"
        },
        "installation_identity_sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "data_bucket": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9](?![\\s\\S])"
        },
        "region": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z]{2}(-[a-z]+)+-[0-9]+(?![\\s\\S])"
        }
      },
      "required": [
        "account_id",
        "project",
        "environment",
        "installation_identity_sha256",
        "data_bucket",
        "region"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z(?![\\s\\S])"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "isolation_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,63}(?![\\s\\S])"
        },
        "data_bucket": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9](?![\\s\\S])"
        },
        "database_identity": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z][a-z0-9-]{1,63}(?![\\s\\S])"
        },
        "original_environment_modified": {
          "const": false
        },
        "storage_identity_remapping_explicitly_approved": {
          "const": true
        }
      },
      "required": [
        "isolation_id",
        "data_bucket",
        "database_identity",
        "original_environment_modified",
        "storage_identity_remapping_explicitly_approved"
      ]
    },
    "compatibility_verified": {
      "const": true
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "decryption": {
          "const": true
        },
        "postgres_restore": {
          "const": true
        },
        "installed": {
          "const": true
        },
        "storage_guard": {
          "const": true
        },
        "object_version_mapping": {
          "const": true
        },
        "file_content_hashes": {
          "const": true
        },
        "login": {
          "const": true
        },
        "postgres_redis_integration": {
          "const": true
        },
        "configuration_apps": {
          "const": true
        },
        "interrupted_restore_resumed": {
          "const": true
        },
        "second_run_no_reinstallation": {
          "const": true
        }
      },
      "required": [
        "decryption",
        "postgres_restore",
        "installed",
        "storage_guard",
        "object_version_mapping",
        "file_content_hashes",
        "login",
        "postgres_redis_integration",
        "configuration_apps",
        "interrupted_restore_resumed",
        "second_run_no_reinstallation"
      ]
    },
    "result": {
      "const": "functional_restore_verified"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "pattern": "^evidence/[A-Za-z0-9-]+/[a-z][a-z0-9_.-]+\\.(?:dump|tar|json)(?![\\s\\S])"
        },
        "version_id": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!null(?![\\s\\S]))[^\\s\\x00-\\x1f\\x7f]+(?![\\s\\S])",
          "maxLength": 1024
        },
        "sha256": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
        },
        "encryption": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "method": {
              "const": "SSE-S3"
            },
            "algorithm": {
              "const": "AES256"
            }
          },
          "required": [
            "method",
            "algorithm"
          ]
        }
      },
      "required": [
        "key",
        "version_id",
        "sha256",
        "encryption"
      ]
    }
  },
  "required": [
    "schema_version",
    "backup_id",
    "manifest_sha256",
    "source",
    "started_at",
    "finished_at",
    "target",
    "compatibility_verified",
    "checks",
    "result",
    "report"
  ]
}
