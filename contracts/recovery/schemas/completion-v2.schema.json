{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nextcloud-platform:recovery:completion:2",
  "title": "Nextcloud recovery completion v2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 2
    },
    "backup_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])"
    },
    "manifest_key": {
      "type": "string",
      "minLength": 1,
      "pattern": "^backups/[A-Za-z0-9-]+/manifest\\.json(?![\\s\\S])"
    },
    "manifest_version_id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!null(?![\\s\\S]))[^\\s\\x00-\\x1f\\x7f]+(?![\\s\\S])",
      "maxLength": 1024
    },
    "manifest_sha256": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z(?![\\s\\S])"
    }
  },
  "required": [
    "schema_version",
    "backup_id",
    "manifest_key",
    "manifest_version_id",
    "manifest_sha256",
    "completed_at"
  ]
}
